<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Hello Seed - 电子宠物系统 (V5.0 最终完全体)</title>
    <style>
        :root {
            --bg-comfy: #e0f2f1; --bg-alert: #ffebee;
            --primary: #4CAF50; --text-main: #333;
            --aura-color: rgba(76, 175, 80, 0); 
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
        
        body { 
            background-color: var(--bg-comfy); 
            display: flex; justify-content: center; align-items: center; 
            width: 100vw; height: 100vh; margin: 0; overflow: hidden; 
            transition: background-color 0.5s ease;
        }

        .app-container {
            width: 100%; height: 100%; 
            background-color: transparent; position: relative;
            display: flex; flex-direction: column; 
        }

        .top-bar { padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; }
        .status-dot { width: 14px; height: 14px; border-radius: 50%; background-color: #ccc; }
        .status-dot.connected { background-color: var(--primary); box-shadow: 0 0 10px var(--primary); }

        .main-layout {
            display: flex; flex: 1; flex-direction: row; padding: 0 40px 40px 40px; gap: 40px; overflow: hidden;
        }

        /* 左侧：宠物舞台与能量场 */
        .pet-stage { 
            flex: 1.5; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative;
            background: rgba(255, 255, 255, 0.5); border-radius: 30px; overflow: hidden; box-shadow: inset 0 0 20px rgba(0,0,0,0.02);
        }

        /* 能量力场特效 */
        .aura {
            position: absolute; width: 400px; height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--aura-color) 0%, rgba(255,255,255,0) 70%);
            opacity: 0; transition: all 1s ease;
            z-index: 1; pointer-events: none;
        }
        @keyframes aura-rotate {
            0% { transform: scale(1) rotate(0deg); opacity: 0.5; }
            50% { transform: scale(1.1) rotate(180deg); opacity: 0.8; }
            100% { transform: scale(1) rotate(360deg); opacity: 0.5; }
        }
        .aura.active { opacity: 1; animation: aura-rotate 4s infinite linear; }

        .bubble {
            background: white; padding: 15px 25px; border-radius: 25px; font-size: 1.1rem;
            color: #555; margin-bottom: 20px; box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            transition: all 0.3s; opacity: 0; transform: translateY(10px); text-align: center; font-weight: bold;
            z-index: 10;
        }

        .pet-image { 
            width: 280px; height: 280px; object-fit: contain;
            display: none; z-index: 5;
            filter: drop-shadow(0 15px 15px rgba(0,0,0,0.15));
            transition: transform 0.25s cubic-bezier(0.25, 0.1, 0.25, 1), filter 0.5s; 
        }

        /* 右侧：数据与面板 */
        .right-panel { flex: 1; display: flex; flex-direction: column; gap: 25px; justify-content: center; }
        .dashboard {
            background: white; border-radius: 30px; padding: 30px;
            display: grid; grid-template-columns: 1fr 1fr; gap: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }
        .data-card { background: #f8f9fa; border-radius: 20px; padding: 20px; text-align: center; }
        .data-value { font-size: 2rem; font-weight: bold; color: var(--primary); margin-top: 8px; }

        .decision-box { 
            background: white; padding: 30px; border-radius: 30px; display: none; 
            flex-direction: column; gap: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }
        .input-group { display: flex; gap: 12px; flex-direction: column; }
        #questionInput { width: 100%; padding: 15px; border: 2px solid #eee; border-radius: 15px; outline: none; font-size: 1rem; }
        #questionInput:focus { border-color: var(--primary); }
        .btn-group { display: flex; gap: 15px; width: 100%; }
        
        button { flex: 1; padding: 15px; border: none; border-radius: 15px; font-weight: bold; font-size: 1.1rem; cursor: pointer; color: white; transition: transform 0.1s; }
        button:active { transform: scale(0.97); }
        #askBtn { background: var(--primary); }
        #drawLotBtn { background: #FF9800; }
        #evolveBtn { background: linear-gradient(135deg, #9C27B0, #673AB7); margin-top: 5px; box-shadow: 0 5px 15px rgba(156, 39, 176, 0.3); } 

        #connectBtn {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            background: linear-gradient(135deg, #4CAF50, #2E7D32); color: white; border: none;
            padding: 20px 60px; border-radius: 50px; font-weight: bold; font-size: 1.3rem; z-index: 100;
            box-shadow: 0 15px 30px rgba(76, 175, 80, 0.4); transition: transform 0.2s, box-shadow 0.2s;
        }
        #connectBtn:hover { transform: translate(-50%, -52%); box-shadow: 0 20px 40px rgba(76, 175, 80, 0.5); }
    </style>
</head>
<body>

<div class="app-container" id="appBg">
    <div class="top-bar">
        <div style="font-weight: 800; font-size: 1.2rem; color: #444; letter-spacing: 1px;">🌱 HELLO SEED <span id="stageLabel" style="font-size: 0.9rem; color: #888; font-weight: normal; margin-left: 10px;">[形态 1]</span></div>
        <div id="statusDot" class="status-dot"></div>
    </div>

    <div class="main-layout">
        <div class="pet-stage">
            <div id="petAura" class="aura"></div>
            <div class="bubble" id="petBubble">请连接串口线以唤醒我...</div>
            < img src="stage1_init.png" alt="Pet" class="pet-image" id="petImg">
        </div>

        <div class="right-panel">
            <div class="dashboard">
                <div class="data-card"><div style="font-size: 1rem; color:#888; font-weight: bold;">🌡️ 温度</div><div class="data-value"><span id="tempVal">--</span>°C</div></div>
                <div class="data-card"><div style="font-size: 1rem; color:#888; font-weight: bold;">💧 湿度</div><div class="data-value"><span id="humVal">--</span>%</div></div>
            </div>

            <div class="decision-box" id="decisionArea">
                <div class="input-group">
                    <input type="text" id="questionInput" placeholder="输入问题，让我帮你决定...">
                    <div class="btn-group">
                        <button id="askBtn">询问解答</button>
                        <button id="drawLotBtn">命运抽签</button>
                    </div>
                    <button id="evolveBtn">✨ 强制进化测试</button>
                </div>
            </div>
        </div>
    </div>

    <button id="connectBtn">🔌 连接硬件设备</button>
</div>

<script>
    const petImg = document.getElementById('petImg');
    const petAura = document.getElementById('petAura');
    const stageLabel = document.getElementById('stageLabel');
    const connectBtn = document.getElementById('connectBtn');
    const petBubble = document.getElementById('petBubble');
    const appBg = document.getElementById('appBg');
    const decisionArea = document.getElementById('decisionArea');
    const evolveBtn = document.getElementById('evolveBtn');
    const questionInput = document.getElementById('questionInput');

    let evolutionLevel = 1; 
    let isBusy = false; 

    // 🌟 精简且准确的预加载列表
    const frames = [
        "stage1_init.png", "stage1_jump1.png", "stage1_jump2.png", "stage1_jump3.png", "stage1_think.png",
        "stage2_init.png", 
        "stage3_init.png",
        "hot.png", "cold.png", "lot_1.png", "lot_2.png", "lot_3.png", "lot_4.png"
    ];
    frames.forEach(f => { const img = new Image(); img.src = f; });

    // 获取当前比例和光环配置
    function getEvoSettings() {
        const settings = {
            1: { scale: 1.0, aura: "rgba(76, 175, 80, 0)", active: false },
            2: { scale: 1.15, aura: "rgba(33, 150, 243, 0.4)", active: true }, 
            3: { scale: 1.3, aura: "rgba(255, 215, 0, 0.6)", active: true }   
        };
        return settings[evolutionLevel];
    }

    // 🌟 核心：多形态渲染器兼容逻辑
    function renderPet(state = 'init', offsetTrigger = 0) {
        const { scale, aura, active } = getEvoSettings();
        
        if (evolutionLevel === 1) {
            petImg.src = `stage1_${state}.png`;
        } else {
            petImg.src = `stage${evolutionLevel}_init.png`;
        }
        
        document.documentElement.style.setProperty('--aura-color', aura);
        if(active) petAura.classList.add('active');
        else petAura.classList.remove('active');

        petImg.style.transform = `scale(${scale}) translateY(${offsetTrigger}px)`;
    }

    // 进化测试
    evolveBtn.addEventListener('click', () => {
        if(evolutionLevel >= 3) evolutionLevel = 1;
        else evolutionLevel++;
        
        stageLabel.innerText = `[形态 ${evolutionLevel}]`;
        petBubble.innerText = "进化了！感觉充满了力量！✨";
        renderPet('init');
        
        document.body.style.backgroundColor = "white";
        setTimeout(() => document.body.style.backgroundColor = "var(--bg-comfy)", 150);
    });

    // --- 平滑跳跃 ---
    function executeJump() {
        if (isBusy) return;
        isBusy = true;
        petBubble.innerText = "跳起来！";
        
        renderPet('jump1', -40);

        setTimeout(() => {
            renderPet('jump2', -80);
        }, 200);

        setTimeout(() => {
            renderPet('jump3', 0);
        }, 400);

        setTimeout(() => {
            renderPet('init', 0);
            isBusy = false;
        }, 600);
    }

    // --- YES/NO 决策 ---
    document.getElementById('askBtn').addEventListener('click', () => {
        const q = questionInput.value.trim();
        if (!q || isBusy) return;

        isBusy = true;
        renderPet('think', 0);
        petBubble.innerText = "让本妙蛙算一算... 🤔";

        setTimeout(() => {
            const isYes = Math.random() > 0.5;
            petBubble.innerText = isYes ? "YES! 冲就完事了！✅" : "NO... 感觉不太行 ❌";
            
            renderPet('init', 0); // 直接恢复原状，不调用 executeJump
            isBusy = false;
            questionInput.value = "";
        }, 1500);
    });

    // --- 命运抽签 ---
    document.getElementById('drawLotBtn').addEventListener('click', () => {
        if (isBusy) return;
        isBusy = true;
        
        renderPet('think', 0);
        petBubble.innerText = "正在疯狂摇签筒... 🎋";
        
        let shakes = 0;
        const s = getEvoSettings().scale;
        const shakeInterval = setInterval(() => {
            shakes++;
            petImg.style.transform = `scale(${s}) rotate(${shakes % 2 === 0 ? 10 : -10}deg)`;
            if (shakes > 10) {
                clearInterval(shakeInterval);
                petImg.style.transform = `scale(${s}) rotate(0deg)`;
            }
        }, 100);

        setTimeout(() => {
            const lot = Math.floor(Math.random() * 4) + 1;
            petImg.src = `lot_${lot}.png`; 
            
            const msgs = {
                1: "大吉！今天运势爆棚，随便造！🌟",
                2: "小吉！稳稳当当，会有好事发生哦~ 🍀",
                3: "大凶！诸事不宜，今天适合躺平 😱",  
                4: "小凶！喝水小心塞牙，走路注意脚下 🤕"   
            };
            petBubble.innerText = msgs[lot];
            
            if (lot === 1) {
                setTimeout(() => {
                    petImg.style.transform = `scale(${s}) translateY(-30px)`;
                    setTimeout(() => petImg.style.transform = `scale(${s}) translateY(0)`, 200);
                }, 500);
            }
            
            setTimeout(() => {
                renderPet('init', 0);
                isBusy = false;
            }, 5000);
        }, 1500);
    });

    // --- 串口连接与环境监听 ---
    connectBtn.addEventListener('click', async () => {
        try {
            const port = await navigator.serial.requestPort();
            await port.open({ baudRate: 115200 });

            document.getElementById('statusDot').classList.add('connected');
            connectBtn.style.display = 'none';
            petImg.style.display = 'block'; 
            decisionArea.style.display = 'flex'; 
            petBubble.style.opacity = '1';
            petBubble.style.transform = 'translateY(0)';
            petBubble.innerText = "主人，连接成功！准备开始整活。";

            const textDecoder = new TextDecoderStream();
            port.readable.pipeTo(textDecoder.writable);
            const reader = textDecoder.readable.getReader();

            let buffer = '';
            while (true) {
                const { value, done } = await reader.read();
                if (done) break;
                if (value) {
                    buffer += value;
                    let lines = buffer.split('\n');
                    buffer = lines.pop();

                    for (let line of lines) {
                        try {
                            const data = JSON.parse(line.trim());
                            document.getElementById('tempVal').innerText = data.t;
                            document.getElementById('humVal').innerText = data.h;

                            if (!isBusy) {
                                if(data.t > 32) {
                                    document.body.style.backgroundColor = 'var(--bg-alert)';
                                    petImg.src = "hot.png";
                                    petBubble.innerText = "太热啦，我要熟了... 🥵";
                                } else if (data.t < 15) {
                                    document.body.style.backgroundColor = 'var(--bg-alert)';
                                    petImg.src = "cold.png";
                                    petBubble.innerText = "好冷，冻僵啦... 🥶";
                                } else {
                                    document.body.style.backgroundColor = 'var(--bg-comfy)';
                                    renderPet('init', 0);
                                }
                            }

                            if(data.p === 1 && !isBusy) {
                                executeJump();
                            }
                        } catch(e) {}
                    }
                }
            }
        } catch (err) {
            alert("无法打开串口，请确保 USB 已连接并关闭了占用串口的其他程序。");
        }
    });

    window.addEventListener('keydown', (e) => {
        if (e.code === 'Space' && !isBusy && petImg.style.display === 'block') {
            e.preventDefault();
            executeJump();
        }
    });
</script>
</body>
</html>
